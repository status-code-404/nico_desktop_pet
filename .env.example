# ── LLM（DeepSeek）──
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Anthropic / Claude（多模态备选）──
ANTHROPIC_API_KEY=sk-your-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro[1m]

# ── 服务配置 ──
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── STT（语音识别 Whisper）──
WHISPER_MODEL_SIZE=base

# ── TTS（阿里云百炼 CosyVoice）──
TTS_PROVIDER=aliyun                                # aliyun | local
DASHSCOPE_API_KEY=sk-your-dashscope-key
COSYVOICE_MODEL=cosyvoice-v3.5-flash
NICOLE_VOICE_ID=                                   # 声音克隆ID，运行 setup_voice.py 获取

# ── 本地 TTS（备选）──
TTS_LOCAL_MODEL=CosyVoice2-0.5B

# ── Debug ──
DEBUG_VOICE=false

# ── 对话上下文 ──
CHAT_MEMORY_ENABLED=false
CHAT_HISTORY_LIMIT=10
CHAT_SEARCH_ENABLED=true
TAVILY_API_KEY=tvly-dev-your-key

# ── 前端配置 ──
PET_WIDTH=180
PET_FPS=24

# ── 功能配置 ──
SCREENSHOT_INTERVAL=10
DRINK_REMINDER_HOURS=1.5
FACE_DETECT_INTERVAL=30
MOOD_REFRESH_INTERVAL=240
