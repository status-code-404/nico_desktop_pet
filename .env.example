# ═══════════════════════════════════════════════════════════════
# 服务提供方 (provider)
# ═══════════════════════════════════════════════════════════════

# LLM: DeepSeek 原生 API
# 来源: https://platform.deepseek.com/api_keys
LLM_PROVIDER=deepseek

# STT: 语音识别
#   whisper    — 本地 openai-whisper 模型
#   volcengine — 豆包流式 ASR (需开通 ASR 服务)
# 来源: https://console.volcengine.com/speech/new/setting/apikeys
STT_PROVIDER=whisper

# TTS: 语音合成
#   aliyun     — 阿里云百炼 CosyVoice
#   volcengine — 豆包双向流式 SeedTTS
#   local      — 本地 CosyVoice2 模型
TTS_PROVIDER=volcengine

# ═══════════════════════════════════════════════════════════════
# API Keys
# ═══════════════════════════════════════════════════════════════

# ── DeepSeek (LLM) ──
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Volcengine TTS (豆包语音合成) ──
VOLCENGINE_TTS_API_KEY=your-volc-tts-key
VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
VOLCENGINE_TTS_SPEAKER=your-speaker-id
VOLCENGINE_TTS_MODEL=seed-tts-2.0-expressive
VOLCENGINE_TTS_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000

# ── Volcengine ASR (豆包语音识别，可选) ──
VOLCENGINE_ASR_API_KEY=your-volc-asr-key

# ── Tavily 搜索 ──
TAVILY_API_KEY=tvly-dev-your-key

# ═══════════════════════════════════════════════════════════════
# 服务配置
# ═══════════════════════════════════════════════════════════════
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
WHISPER_MODEL_SIZE=base

# ═══════════════════════════════════════════════════════════════
# 功能开关
# ═══════════════════════════════════════════════════════════════
DEBUG_VOICE=false
CHAT_MEMORY_ENABLED=false
CHAT_SEARCH_ENABLED=true
CHAT_HISTORY_LIMIT=10
TTS_CONCURRENCY=3

# ═══════════════════════════════════════════════════════════════
# 前端配置
# ═══════════════════════════════════════════════════════════════
PET_WIDTH=180
PET_FPS=24

# ═══════════════════════════════════════════════════════════════
# 功能配置
# ═══════════════════════════════════════════════════════════════
SCREENSHOT_INTERVAL=10
DRINK_REMINDER_HOURS=1.5
FACE_DETECT_INTERVAL=30
MOOD_REFRESH_INTERVAL=240
